#!/usr/bin/env bash
#MISE description="Lint prose with vale and fail on any alert"
#MISE hide=true
#MISE depends=["vale:sync"]
set -eu

# vale fails only on errors, so any output, including a suggestion, fails
# here. --no-global keeps a machine's own vale config out of the result.
# The agent rules quote the phrases they ban.
alerts=$(git ls-files -z '*.md' ':!modules/agents/.agents/AGENTS.md' ':!modules/agents/.pi/agent/AGENTS.md' ':!modules/agents/.claude/CLAUDE.md' |
  xargs -0 vale --no-global --config .mise/vale/.vale.ini --output=line 2>&1 || true)
if [ -n "$alerts" ]; then
  echo "$alerts"
  exit 1
fi
