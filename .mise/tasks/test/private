#!/usr/bin/env bash
#MISE description="Check that encrypt and decrypt round-trip the private archive"
#MISE hide=true
set -eu
. .mise/lib.sh
scratch test-private
# The repo's git config includes the identity that decrypt writes.
mkdir -p "$tmp/home/.config/git"
ln -s "$PWD/modules/core/.config/git/config" "$tmp/home/.config/git/config"

# Without op, decrypt writes nothing and exits cleanly, so the apply
# goes on and the next one retries.
status=0
env PATH=/usr/bin:/bin HOME="$tmp/home" setup/private/decrypt 2>/dev/null || status=$?
[ "$status" = 0 ] || {
  echo "decrypt without op exited $status, not 0"
  exit 1
}
test ! -e "$tmp/home/.config/git/identity" || {
  echo "decrypt wrote without op"
  exit 1
}

# encrypt archives files under $HOME into private/home.tar.age, and
# decrypt writes them back, where git picks up the identity. Copies of the
# scripts work on a test private/ with a test age key, which a stub op
# returns, and a test signing key, which git config names.
repo="$tmp/repo"
mkdir -p "$repo/setup/private" "$repo/.mise/tasks" "$repo/private" \
  "$tmp/stub" "$tmp/home/.config/git" "$tmp/home/.ssh"
cp setup/private/decrypt setup/private/archive.sh "$repo/setup/private/"
cp .mise/tasks/encrypt "$repo/.mise/tasks/"
cp .mise/lib.sh "$repo/.mise/"
age-keygen -pq -o "$tmp/key" 2>/dev/null
age-keygen -y "$tmp/key" >"$repo/private/recipients"
printf '#!/bin/sh\ncat "%s"\n' "$tmp/key" >"$tmp/stub/op"
chmod +x "$tmp/stub/op"
ssh-keygen -q -t ed25519 -N '' -f "$tmp/signer"
ssh-keygen -q -t ed25519 -N '' -f "$tmp/stranger"
printf 'dotfiles namespaces="dotfiles-archive" %s\n' "$(cat "$tmp/signer.pub")" >"$repo/private/allowed_signers"
run() {
  (cd "$repo" && env PATH="$tmp/stub:$PATH" HOME="$tmp/home" \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=user.signingkey GIT_CONFIG_VALUE_0="$tmp/signer" "$@")
}
decrypt() { run setup/private/decrypt; }
encrypt() { run .mise/tasks/encrypt "$@"; }

# A second encrypt adds to the archive and keeps the first file.
identity="$tmp/home/.config/git/identity"
printf '[user]\n\temail = ada@example.com\n[credential "https://github.com"]\n\thelper = ada\n' >"$identity"
touch -t 200001010000 "$identity"
encrypt "$identity"
echo ada >"$tmp/home/.ssh/github.pub"
encrypt "$tmp/home/.ssh/github.pub"
rm "$identity" "$tmp/home/.ssh/github.pub"
decrypt
test -e "$tmp/home/.ssh/github.pub" || {
  echo "second encrypt dropped a file"
  exit 1
}
[ -n "$(find "$identity" -perm 600)" ] || {
  echo "decrypted identity is readable by others"
  exit 1
}
[ -z "$(find "$repo/private" -name '*identity*')" ] || {
  echo "private/ names the identity"
  exit 1
}
if encrypt "$tmp/home/../escape" 2>/dev/null; then
  echo "encrypt accepted a path outside HOME"
  exit 1
fi
email=$(HOME="$tmp/home" XDG_CONFIG_HOME="$tmp/home/.config" \
  git config --global --includes user.email)
[ "$email" = ada@example.com ] || {
  echo "decrypted identity not included: got '$email'"
  exit 1
}

# A credential helper in the identity wins over the repo's.
helper=$(HOME="$tmp/home" XDG_CONFIG_HOME="$tmp/home/.config" \
  git config --global --includes --get-all credential.https://github.com.helper | tail -1)
[ "$helper" = ada ] || {
  echo "identity credential helper overridden: got '$helper'"
  exit 1
}

# An unchanged plaintext decrypts again silently, and one edited after
# its archived copy survives the next decrypt.
[ -z "$(decrypt 2>&1)" ] || {
  echo "decrypt skipped an unchanged plaintext"
  exit 1
}
echo edited >>"$tmp/home/.config/git/identity"
decrypt 2>/dev/null
grep -qx edited "$tmp/home/.config/git/identity" || {
  echo "decrypt overwrote an edited plaintext"
  exit 1
}

# The archive only adds files. A link at an archived path points into the
# repo, as setup/link's links do, so decrypt leaves it alone instead of
# writing private content into a tracked file. encrypt refuses links.
tracked="$tmp/tracked"
mkdir -p "$tracked" "$tmp/home/.config/fish"
local_fish="$tmp/home/.config/fish/local.fish"
echo private >"$local_fish"
encrypt "$local_fish"
rm "$local_fish"
echo tracked >"$tracked/local.fish"
touch -t 200001010000 "$tracked/local.fish"
ln -s "$tracked/local.fish" "$local_fish"
decrypt 2>/dev/null
grep -qx tracked "$tracked/local.fish" || {
  echo "decrypt wrote through a link into a tracked file"
  exit 1
}
if encrypt "$local_fish" 2>/dev/null; then
  echo "encrypt accepted a link"
  exit 1
fi

# decrypt refuses an archive without a signature, with one from a key
# that private/allowed_signers lacks, and with one for other content.
archive="$repo/private/home.tar.age"
rm "$local_fish"
cp "$archive.sig" "$tmp/good.sig"
rm "$archive.sig"
if decrypt 2>/dev/null; then
  echo "decrypt accepted an unsigned archive"
  exit 1
fi
ssh-keygen -Y sign -n dotfiles-archive -f "$tmp/stranger" <"$archive" >"$archive.sig" 2>/dev/null
if decrypt 2>/dev/null; then
  echo "decrypt accepted a signature from a key it doesn't allow"
  exit 1
fi
ssh-keygen -Y sign -n dotfiles-archive -f "$tmp/signer" <"$repo/private/recipients" >"$archive.sig" 2>/dev/null
if decrypt 2>/dev/null || encrypt 2>/dev/null; then
  echo "decrypt or encrypt accepted a signature for other content"
  exit 1
fi
test ! -e "$local_fish" || {
  echo "decrypt wrote from an archive it refused"
  exit 1
}
cp "$tmp/good.sig" "$archive.sig"
decrypt 2>/dev/null
test -e "$local_fish" || {
  echo "decrypt refused a good signature"
  exit 1
}
echo "private ok"
