#!/usr/bin/env bash
#MISE description="Check how agents vm runs Claude Code through agentvm and feeds the picker"
#MISE hide=true
set -eu
. .mise/lib.sh
scratch test-agents-vm
libexec=$PWD/modules/agents/.local/libexec/agents

# A stub agentvm, where the agentvm module installs it, records its
# arguments one per line.
export HOME="$tmp/home" ARGV_LOG="$tmp/argv.log" XDG_STATE_HOME="$tmp/state"
mkdir -p "$HOME/.local/libexec/agentvm"
cat >"$HOME/.local/libexec/agentvm/agentvm" <<'EOF'
#!/bin/sh
printf '%s\n' "$@" >"$ARGV_LOG"
EOF
chmod +x "$HOME/.local/libexec/agentvm/agentvm"

# Without a command, and with help, it prints the help and starts nothing.
for args in "" help -h --help; do
  # shellcheck disable=SC2086
  out=$("$libexec/vm-agent" $args)
  [[ "$out" == *"Usage: agents vm"* ]] || fail "agents vm $args printed no help"
  [ ! -e "$ARGV_LOG" ] || fail "agents vm $args started agentvm"
done

# Claude Code runs with its credentials profile, a placeholder token, its
# transcripts kept per repository, and the picker's status command.
"$libexec/vm-agent" claude --resume
expected=$(printf '%s\n' --extends agentvm-claude --env CLAUDE_CODE_OAUTH_TOKEN=nono-proxy \
  --env DISABLE_AUTOUPDATER=1 --persist .claude/projects --on-status "$libexec/vm-status" \
  run -- claude --resume)
[ "$(cat "$ARGV_LOG")" = "$expected" ] || fail "agents vm claude passed: $(cat "$ARGV_LOG")"

# --github stacks the GitHub routes and a placeholder for gh, and
# --publish serves a port.
"$libexec/vm-agent" shell --github --publish 3000
grep -qx github "$ARGV_LOG" && grep -qx GH_TOKEN=nono-proxy "$ARGV_LOG" && grep -qx shell "$ARGV_LOG" ||
  fail "--github passed: $(cat "$ARGV_LOG")"
grep -qx -- --publish "$ARGV_LOG" && grep -qx 3000 "$ARGV_LOG" || fail "--publish passed: $(cat "$ARGV_LOG")"
"$libexec/vm-agent" build --fresh
[ "$(cat "$ARGV_LOG")" = "$(printf 'build\n--fresh')" ] || fail "build passed: $(cat "$ARGV_LOG")"
"$libexec/vm-agent" stop
[ "$(tail -n 1 "$ARGV_LOG")" = stop ] || fail "stop passed: $(cat "$ARGV_LOG")"
"$libexec/vm-agent" ls
[ "$(cat "$ARGV_LOG")" = ls ] || fail "ls passed: $(cat "$ARGV_LOG")"
! "$libexec/vm-agent" bogus >/dev/null 2>&1 || fail "an unknown command succeeded"

# vm-status writes the picker entry for this pane from the guest's
# record, and clears it for an unknown state and when the VM stops.
entry="$XDG_STATE_HOME/agents/wezterm-7"
status() {
  env -u TMUX_PANE WEZTERM_PANE=7 "$libexec/vm-status" "$@"
}
status wezterm-0 "$(printf 'claude\tbusy\tBash\t1\t/work')"
[ "$(cut -f1-3 "$entry")" = "$(printf 'claude\tbusy\tBash')" ] || fail "the picker missed the VM's agent"
status wezterm-0.task "fix the tests"
[ "$(cat "$entry.task")" = "fix the tests" ] || fail "the picker missed the task"
status wezterm-0 "$(printf 'claude\tpwned\tBash\t1\t/work')"
[ ! -e "$entry" ] || fail "the picker took an unknown state"
status wezterm-0 "$(printf 'claude\tidle\t-\t1\t/work')"
status
[ ! -e "$entry" ] || fail "the picker entry stayed after the VM stopped"
echo "agents-vm ok"
