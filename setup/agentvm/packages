#!/bin/bash
# The dotfiles' packages for the agent VM's image. agentvm's prepare
# script runs it as root during `agentvm build`, in the layer the builder
# caches, with the user already in place. BASE is a tree with this script
# and the sandbox package list.
#
# Usage: packages BASE USER
set -euxo pipefail

base=$1 user=$2
home=/home/$user

# The VM boots its own kernel, so the distribution's kernel and firmware
# only take space.
pacman -Rns --noconfirm linux-aarch64 linux-firmware || :
mapfile -t packages < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$base/setup/packages/arch/sandbox.txt")
pacman -S --noconfirm --needed "${packages[@]}"
# Arch Linux ARM doesn't package mise, so it comes from upstream.
curl -fsSL https://mise.run | MISE_VERSION=v2026.11.4 MISE_INSTALL_PATH=/usr/local/bin/mise sh

usermod -s /usr/bin/fish "$user"
# Rootless podman maps the IDs in a container to these. The VM has no
# network device, and pasta, podman's default network, needs a tun device
# it lacks too. Containers share the VM's network instead, where the proxy
# listens, and podman passes them the proxy variables.
usermod --add-subuids 100000-165535 --add-subgids 100000-165535 "$user"
# The proxy signs TLS with its own CA, so every container gets the VM's
# bundle at the path most distributions read. Node reads neither that
# bundle nor the proxy variables on its own.
mkdir -p /etc/containers/containers.conf.d
cat >/etc/containers/containers.conf.d/agentvm.conf <<'EOF'
[containers]
netns = "host"
volumes = ["/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro"]
env = ["NODE_USE_ENV_PROXY=1", "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt"]
EOF
# Builds ignore that env, so a wrapper passes Node's proxy switch to every
# build step. The images it builds carry the variable.
cat >/usr/local/bin/podman <<'EOF'
#!/bin/sh
case " $* " in
*" build "*) exec /usr/bin/podman "$@" --env NODE_USE_ENV_PROXY=1 ;;
esac
exec /usr/bin/podman "$@"
EOF
chmod 755 /usr/local/bin/podman

# The minimal profile leaves out rust-docs, which nobody reads in the VM
# and which would double the toolchain's size.
runuser -u "$user" -- env HOME="$home" USER="$user" \
  RUSTUP_HOME="$home/.local/share/rustup" CARGO_HOME="$home/.local/share/cargo" \
  bash -euxo pipefail -c '
  rustup toolchain install stable --profile minimal \
    --component clippy --component rustfmt --component rust-analyzer --component rust-src
  rustup default stable
'
