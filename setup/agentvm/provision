#!/bin/bash
# The dotfiles' recipe for the agent VM's image. agentvm's prepare script
# runs it as root during `agentvm build`, after the sandbox's own setup,
# with the user already in place. SOURCE is this repository's working
# tree as a tarball.
#
# Usage: provision SOURCE USER
set -euxo pipefail

source=$1 user=$2
home=/home/$user
dotfiles=$home/dotfiles

# The links that setup/apply makes point into this copy of the dotfiles.
# It stays read-only, as setup/apply expects of a checkout it must not
# manage.
mkdir -p "$dotfiles"
tar -xf "$source" -C "$dotfiles" --no-same-owner
chown -R "$user:" "$dotfiles"
chmod -R a-w "$dotfiles"

# The VM boots its own kernel, so the distribution's kernel and firmware
# only take space.
pacman -Rns --noconfirm linux-aarch64 linux-firmware || :
mapfile -t packages < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$dotfiles/setup/packages/arch/sandbox.txt")
pacman -S --noconfirm --needed "${packages[@]}"
# Arch Linux ARM doesn't package mise, so it comes from upstream.
curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

usermod -s /usr/bin/fish "$user"
# Rootless podman maps the IDs in a container to these. The VM has no
# network device, and pasta, podman's default network, needs a tun device
# it lacks too. Containers share the VM's network instead, where the proxy
# listens, and podman passes them the proxy variables.
usermod --add-subuids 100000-165535 --add-subgids 100000-165535 "$user"
# The proxy signs TLS with its own CA, so every container gets the VM's
# bundle at the path most distributions read. Node reads neither that
# bundle nor the proxy variables on its own.
mkdir -p /etc/containers/containers.conf.d
cat >/etc/containers/containers.conf.d/agentvm.conf <<'EOF'
[containers]
netns = "host"
volumes = ["/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro"]
env = ["NODE_USE_ENV_PROXY=1", "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt"]
EOF
# Builds ignore that env, so a wrapper passes Node's proxy switch to every
# build step. The images it builds carry the variable.
cat >/usr/local/bin/podman <<'EOF'
#!/bin/sh
case " $* " in
*" build "*) exec /usr/bin/podman "$@" --env NODE_USE_ENV_PROXY=1 ;;
esac
exec /usr/bin/podman "$@"
EOF
chmod 755 /usr/local/bin/podman

# lazy.nvim rewrites its lockfile after the plugin install below, with
# the same versions. Only for that write does the file take one.
chmod u+w "$dotfiles/modules/core/.config/lazyvim/lazy-lock.json"
runuser -u "$user" -- env HOME="$home" USER="$user" bash -euxo pipefail -c '
  curl -fsSL https://claude.ai/install.sh | bash -s -- latest
  export RUSTUP_HOME=$HOME/.local/share/rustup CARGO_HOME=$HOME/.local/share/cargo
  rustup default stable
  fish --no-config "$1/setup/apply"
  "$HOME/.local/libexec/agents/agent-skills" ensure claude
  # The VM throws its disk away, and lazy.nvim writes its lockfile after
  # an install, which the read-only dotfiles refuse. The plugins install
  # here, at the lockfile'"'"'s versions, so a session finds none missing.
  fish -lc "nvim --headless \"+Lazy! restore\" +qa"
  fish -lc "nvim --headless \"+luafile $1/setup/agentvm/treesitter.lua\" +qa"
  fish -lc "nvim --headless \"+luafile $1/setup/agentvm/mason.lua\" +qa"
' sh "$dotfiles"
chmod a-w "$dotfiles/modules/core/.config/lazyvim/lazy-lock.json"
