#!/usr/bin/env bash
# Decrypts private/home.tar.age, an archive of files under $HOME, into
# $HOME with the age key in 1Password. One archive keeps the file names
# out of the public repo. `mise run encrypt <file>` adds a file to it.
# Without op, age, or the key, it decrypts nothing, and the next apply
# retries. An archive without a valid signature from a key in
# private/allowed_signers fails the apply.
set -euo pipefail
umask 077

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
. "$repo/setup/private/archive.sh"
archive="$repo/private/home.tar.age"

if ! command -v op >/dev/null || ! command -v age >/dev/null; then
  echo "private: op or age not found, skipping" >&2
  exit 0
fi
if ! key=$(op read "$key_ref" 2>/dev/null); then
  echo "private: no age key at $key_ref, skipping" >&2
  exit 0
fi

if [[ ! -e "$archive.sig" ]]; then
  echo "private: $archive.sig is missing. An archive from before signing needs one run of mise run encrypt to sign it" >&2
  exit 1
fi
if ! verify_archive "$archive" "$repo"; then
  echo "private: $archive fails its signature check against private/allowed_signers, refusing to decrypt" >&2
  exit 1
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/private.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
age --decrypt --identity <(printf '%s\n' "$key") "$archive" | tar -xzf - -C "$tmp"

cd "$tmp"
find . -type f | while IFS= read -r file; do
  target="$HOME/${file#./}"

  # The archive only adds files. A link points into the repo, as setup/link's
  # do, and cp would write the private content into the tracked file.
  if [[ -L "$target" ]]; then
    echo "private: skipped $target, a link into the repo; the archive only adds files" >&2
    continue
  fi

  # A plaintext newer than its archived copy holds edits not yet
  # encrypted. The archive keeps each file's mtime, and decrypt copies it.
  if [[ "$target" -nt "$file" ]]; then
    echo "private: skipped $target, newer than its archived copy; run mise run encrypt" >&2
    continue
  fi

  mkdir -p "${target%/*}"
  cp "$file" "$target"
  chmod 600 "$target"
  touch -r "$file" "$target"
done
