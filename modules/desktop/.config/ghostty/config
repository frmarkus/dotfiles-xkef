# https://ghostty.org/docs/config

# ── Font ──────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 14
adjust-cell-height = 20%
minimum-contrast = 1.1

# ── Input ─────────────────────────────────────────────
# Left Option sends Alt for the shell and tv bindings. Right Option still
# types special characters such as @, [], and {}.
macos-option-as-alt = left

# ── Theme ─────────────────────────────────────────────
# The ghostty hook of `theme` links the untracked ./theme to the theme's
# palette file and reloads Ghostty. Until then Ghostty keeps its own
# colors, and `theme` alone holds the default theme. The path is absolute
# because this file is a link into the dotfiles repo.
config-file = ?~/.config/ghostty/theme

# ── Window ────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 0
window-padding-balance = true
macos-titlebar-style = hidden
window-theme = ghostty
unfocused-split-opacity = 0.9
confirm-close-surface = false

# ── Cursor ────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
shell-integration-features = cursor,sudo,title,ssh-env

# Starts fish even where the login shell stays zsh, as on a macOS account
# without admin rights, which can't change /etc/shells. fish then runs
# conf.d/ghostty.fish, which attaches tmux. The absolute path avoids the
# minimal PATH of an app started from the Dock. Homebrew's location is
# macOS only.
command = /opt/homebrew/bin/fish
# Smears the cursor along its jump, as Neovide's animated cursor does.
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl

# ── Clipboard ────────────────────────────────────────
copy-on-select = clipboard

# ── Mouse ─────────────────────────────────────────────
mouse-hide-while-typing = true

# ── Keybindings ───────────────────────────────────────
# The macOS cmd bindings stay built in. These add the Linux ctrl+shift
# equivalents on every platform.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
keybind = ctrl+shift+f=toggle_fullscreen

# ── Quick terminal ─────────────────────────────────
quick-terminal-size = 50%
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# ── State ─────────────────────────────────────────
window-save-state = always

# ── Local overrides ───────────────────────────────
# Per-machine overrides, untracked. Ghostty loads it after this file.
config-file = ?~/.config/ghostty/local
