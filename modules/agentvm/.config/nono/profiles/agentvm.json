{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "description": "Egress allowlist for agentvm's proxy: the VM reaches only these hosts. A machine adds its own in agentvm-local, and callers stack credential profiles on top",
    "name": "agentvm",
    "version": "1.0.0"
  },
  "network": {
    "allow_domain": [
      "*.anthropic.com",
      "claude.ai",
      "*.claude.ai",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "registry.npmjs.org",
      "nodejs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "crates.io",
      "*.crates.io",
      "static.rust-lang.org",
      "proxy.golang.org",
      "sum.golang.org",
      "go.dev",
      "dl.google.com",
      "*.sigstore.dev",
      "registry-1.docker.io",
      "auth.docker.io",
      "production.cloudfront.docker.com",
      "ghcr.io",
      "quay.io",
      "*.quay.io",
      "*.jdx.dev",
      "sh.rustup.rs",
      "get.helm.sh",
      "download.java.net",
      "download.oracle.com",
      "cdn.azul.com",
      "corretto.aws"
    ]
  }
}
