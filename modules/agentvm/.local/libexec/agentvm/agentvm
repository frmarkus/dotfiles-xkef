#!/usr/bin/env bash
# Runs a command in a microVM on a copy of the current repository. The VM
# is the sandbox: it has no network device, and its only way out is a
# socket to a credential proxy, which reaches only the hosts that the
# agentvm nono profile allows.
#
#   agentvm [options] run -- CMD [ARGS...]   CMD in the VM's login shell
#   agentvm [options] shell                  a login shell
#   agentvm [options] pane DIR               a login shell in DIR, on the
#                                            copy as it stands
#   agentvm take                             apply the copy's changes here
#   agentvm drop                             discard the copy's changes
#   agentvm stop                             stop this repository's VM
#   agentvm ls                               list the VMs
#   agentvm build [--fresh]                  build the image, --fresh
#                                            without the layer cache
#   agentvm prune                            stop every VM and free the
#                                            builder and unused images
#
#   --extends PROFILE   stack a nono profile on the proxy (repeatable)
#   --env KEY=VALUE     set a variable in the session (repeatable)
#   --persist PATH      keep this path under the guest's home between
#                       sessions, per repository (repeatable)
#   --mount PATH[:ro]   share this host path at the same path (repeatable)
#   --publish PORT      serve the guest's PORT on the host's loopback
#                       (repeatable)
#   --cpus N            the VM's CPUs, config.toml's unless set
#   --memory SIZE       the VM's memory, config.toml's unless set
#   --on-status CMD     run CMD NAME VALUE when the guest changes a status
#                       file, and CMD alone when the session ends
#
# Each repository gets one VM, which the first session starts and `stop`
# ends. Later sessions, panes, take, and drop run inside it through
# `container exec`, so they pay no boot. The VM's shares, ports, size,
# and proxy profiles come from the session that started it, except that
# a later session's profiles join the proxy's.
#
# The guest fetches the host's working tree as a commit into a copy that
# lives on the host, in the repository's folder under $STATE/copies, and
# replaces the copy only while it holds no changes of its own. The copy's
# changes come back as commits in a git bundle, whose diff applies only
# after you review it, and host git never runs inside the copy, so
# nothing the VM writes runs on the host before then.
#
# guest/session.sh runs in the VM, and image/ holds what `agentvm build`
# builds the image from.
set -euo pipefail

readonly LIBEXEC="${BASH_SOURCE[0]%/*}"
readonly DATA="${XDG_DATA_HOME:-$HOME/.local/share}/agentvm"
readonly STATE="${XDG_STATE_HOME:-$HOME/.local/state}/agentvm"
readonly CA_CERT="$STATE/ca.pem" CA_KEY="$STATE/ca.key"
# WezTerm writes images pasted into a VM pane here, which the VM reads.
readonly CLIPBOARD="$HOME/.cache/agentvm-clipboard"
# A machine adds its own hosts or credentials in this untracked profile.
readonly LOCAL_PROFILE=agentvm-local

readonly IMAGE=agentvm:latest
# The prefix of the VMs' names, which `container` makes their host
# names. WezTerm reads the name from OSC 7.
readonly HOST=agentvm
readonly GUEST_HOME="/home/$USER"
# The guest side of the shared directories, as guest/session.sh expects
# them.
readonly GUEST_DIR=/opt/agentvm
# The host's guest/ directory, mounted read-only, so the guest runs the
# script this one expects whatever image the VM has.
readonly GUEST_SESSION=$GUEST_DIR/guest/session.sh
# Where the guest listens for a published port: its own disk, since a
# shared directory takes no Unix socket.
readonly GUEST_PORTS="$GUEST_HOME/.local/state/agentvm/ports"
# Paths under the guest's home that every session keeps per repository.
readonly CACHES=(.cache .local/share/mise .local/share/cargo .local/share/go)

# The status files the guest may write, and how much of each the host
# reads.
readonly STATUS_NAME='^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$'
readonly STATUS_FILES=16 STATUS_BYTES=512

# Arch Linux ARM serves its rootfs over plain HTTP only, so its signature
# decides. The key is the "builder" entry in the project's keyring, which
# GitHub serves over HTTPS.
readonly ALARM=http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz
readonly ALARM_KEYRING=https://raw.githubusercontent.com/archlinuxarm/archlinuxarm-keyring/master/archlinuxarm.gpg
readonly ALARM_KEY=68B3537F39A313B3E574D06777193F152BDBE6A6
# The recipe, in the dotfiles: the packages script and its list go into
# the image's cached layer, and image/Containerfile runs the provision
# script on the whole tree in the last one.
readonly RECIPE_BASE=(setup/agentvm/packages setup/packages/arch/sandbox.txt)

# nono rejects LibreSSL's EC keys, and Homebrew keeps openssl@3 keg-only.
OPENSSL="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/openssl@3/bin/openssl"
[ -x "$OPENSSL" ] || OPENSSL=openssl
readonly OPENSSL

main() {
  [ "$(uname -s)" = Darwin ] || die "the VM runs on macOS"
  parse_args "$@"
  mkdir -p "$STATE"
  case "$mode" in
  build)
    build
    return
    ;;
  ls)
    list_vms
    return
    ;;
  prune)
    prune
    return
    ;;
  esac

  find_repository
  open_session
  case "$mode" in
  stop) stop_vm ;;
  take)
    ensure_vm
    fetch_bundle
    review
    ;;
  drop)
    ensure_vm
    guest reset </dev/null
    ;;
  *) run_session ;;
  esac
}

# Sets $mode, its arguments in $args, and the options.
parse_args() {
  profiles=()
  env=()
  persist=()
  mounts=()
  ports=()
  size=()
  on_status=
  fresh=
  [ ! -f "$HOME/.config/nono/profiles/$LOCAL_PROFILE.json" ] || profiles+=("$LOCAL_PROFILE")
  while [ $# -gt 0 ]; do
    case $1 in
    --extends) profiles+=("${2:?}") ;;
    --env) env+=(--env "${2:?}") ;;
    --persist) persist+=("${2:?}") ;;
    --mount) mounts+=("${2:?}") ;;
    --publish) ports+=("${2:?}") ;;
    --cpus) size+=(--cpus "${2:?}") ;;
    --memory) size+=(--memory "${2:?}") ;;
    --on-status) on_status=${2:?} ;;
    -h | --help) usage 0 ;;
    *) break ;;
    esac
    shift 2
  done

  mode=${1:-}
  [ $# -eq 0 ] || shift
  case "$mode" in
  run)
    [ "${1:-}" != -- ] || shift
    [ $# -gt 0 ] || usage 2
    ;;
  shell | take | drop | stop | ls | prune) ;;
  pane) [ $# -eq 1 ] || usage 2 ;;
  build)
    [ "${1:-}" != --fresh ] || fresh=1
    ;;
  *) usage 2 ;;
  esac
  args=("$@")
}

# Sets $root, the repository's top level or empty outside one, and
# $workdir, where the session starts.
#
# Git in a repository the guest wrote, such as a copy, can run that
# guest's hooks and config on the host. A split of a VM pane passes the
# folder the guest reported, so the check covers it. The folder names
# the VM, so it must exist on the host too.
find_repository() {
  if [ "$mode" = pane ]; then
    cd "${args[0]}" 2>/dev/null || die "${args[0]} is not a folder on the host"
  fi
  case "$(pwd -P)/" in
  "$(cd "$STATE" && pwd -P)"/*) die "refusing to run inside $STATE" ;;
  esac

  root=
  workdir=$HOME
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    root=$(git rev-parse --show-toplevel)
    workdir="$root/$(git rev-parse --show-prefix)"
  elif [ "$mode" != shell ] && [ "$mode" != pane ] && [ "$mode" != stop ]; then
    die "$PWD is not in a git repository"
  fi
  [ "$mode" != pane ] || workdir=${args[0]}
}

# Creates the session's private folder, which the exit removes, and
# names the repository's folder and VM.
#
# The repository's folder holds what the VM mounts. Each sits directly
# in copies/, which only the host writes. Named after the repository's
# path, a nested repository's folder would sit in the outer copy, where
# the outer repository's VM could swap it for a link to any host
# directory. A shell outside a repository gets a folder of its own.
open_session() {
  local hash slug
  session=$(umask 077 && mktemp -d "$STATE/session.XXXXXX")
  trap cleanup EXIT

  if [ -n "$root" ]; then
    hash=$(printf '%s' "$root" | shasum -a 256 | cut -c1-16)
    folder="$STATE/copies/${root##*/}-$hash"
    slug=$(printf '%s' "${root##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')
    name="$HOST-${slug:0:32}-${hash:0:8}"
  else
    folder="$STATE/shell"
    name="$HOST-shell"
  fi
  # The VM's runtime: the proxy, the bridge, and the exchange directory.
  run="$folder/run"
  mkdir -p "$folder"
  # What every guest process needs, at the VM's start and in each exec,
  # since an exec may not inherit the VM's environment.
  guest_env=(
    --env "HOME=$GUEST_HOME" --env "USER=$USER" --env "AGENTVM_ROOT=$root"
    --env "AGENTVM_NAME=$(git config user.name || echo "$USER")"
    --env "AGENTVM_EMAIL=$(git config user.email || echo "$USER@localhost")"
  )
}

# Runs the command, the shell, or the pane in the VM, then reviews what
# the command and the shell changed in the copy.
run_session() {
  local rc=0
  ensure_vm
  if [ "$mode" != pane ] && [ -n "$root" ]; then
    snap=$(snapshot)
  fi
  mark_pane
  [ "$mode" = pane ] || start_status
  guest "$mode" ${args[@]+"${args[@]}"} || rc=$?
  stop_status
  if [ "$mode" != pane ] && [ -n "$root" ]; then
    fetch_bundle
    review
  fi
  return "$rc"
}

# OSC 7 with the VM's name tells WezTerm the pane works in the VM, which
# the status line marks and splits follow. tmux takes no host from OSC 7,
# so the pane carries an option instead, which the window formats in
# theme.conf mark and the cleanup removes.
mark_pane() {
  if [ -t 1 ]; then
    printf '\e]7;file://%s%s\e\\' "$name" "$workdir"
  fi
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux set -p -t "$TMUX_PANE" @agentvm 1
  fi
}

cleanup() {
  [ -z "${starting:-}" ] || stop_vm
  stop_status
  [ -z "${TMUX_PANE:-}" ] || tmux set -pu -t "$TMUX_PANE" @agentvm 2>/dev/null || :
  rm -rf "$session"
}

# Starts the VM unless it runs, and lets a start another process began
# finish first. The run directory is the lock: whoever creates it
# starts. A run directory without a live starter and a VM is left from a
# crash or a reboot, and goes.
ensure_vm() {
  local starter
  for _ in $(seq 600); do
    if vm_running; then
      ensure_profiles
      return
    fi
    if mkdir -m 700 "$run" 2>/dev/null; then
      echo $$ >"$run/starter"
      start_vm
      return
    fi
    starter=$(cat "$run/starter" 2>/dev/null || :)
    if [ -n "$starter" ] && ! kill -0 "$starter" 2>/dev/null; then
      clear_run
      continue
    fi
    sleep 0.1
  done
  die "another agentvm is still starting the VM, see $run"
}

vm_running() {
  container list --quiet 2>/dev/null | grep -qx "$name"
}

# Starts the proxy, its bridge, and the VM, detached from this session.
#
# The guest writes to the exchange directory it shares with the host, so
# the VM gets a new one. Nothing an earlier VM left there, such as a
# link, can redirect the host's write of the proxy password.
start_vm() {
  local path port opts=()
  starting=1
  check_image
  ensure_ca
  mkdir -p "$CLIPBOARD" "$run/exchange"
  (umask 077 && "$OPENSSL" rand -hex 16 >"$run/pass" && printf 'nono:%s' "$(cat "$run/pass")" >"$run/exchange/proxy")
  echo "$name" >"$run/name"
  echo "${root:-no repository}" >"$run/root"
  printf '%s\n' ${profiles[@]+"${profiles[@]}"} | sort -u >"$run/profiles"
  start_proxy 0 "$run/profiles"
  start_bridge

  opts+=(--mount "type=bind,source=$run/exchange,target=$GUEST_DIR/session")
  opts+=(--mount "type=bind,source=$(guest_dir),target=$GUEST_DIR/guest,readonly")
  opts+=(--mount "type=bind,source=$CLIPBOARD,target=$CLIPBOARD,readonly")
  for path in "${CACHES[@]}" ${persist[@]+"${persist[@]}"}; do
    mkdir -p "$folder/home/$path"
    opts+=(--mount "type=bind,source=$folder/home/$path,target=$GUEST_HOME/$path")
  done
  for path in ${mounts[@]+"${mounts[@]}"}; do
    opts+=(--mount "$(share "$path")")
  done
  for port in ${ports[@]+"${ports[@]}"}; do
    opts+=(--publish-socket "$run/ports/$port:$GUEST_PORTS/$port")
  done
  if [ -n "$root" ]; then
    mkdir -p "$folder/copy"
    opts+=(--mount "type=bind,source=$folder/copy,target=$root")
    opts+=(--mount "type=bind,source=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir),target=$GUEST_DIR/git,readonly")
  fi

  # Linux refuses a nested /proc mount, which podman in the VM needs, while
  # parts of /proc are masked. The masks guard a kernel shared with the
  # host, and the VM's kernel is its own.
  mkdir -p "$run/ports"
  container run --detach --network none --progress none \
    --masked-path NONE --read-only-path NONE \
    --name "$name" --uid "$(id -u)" --gid "$(id -g)" ${size[@]+"${size[@]}"} \
    "${opts[@]}" --volume "$run/proxy.sock:$GUEST_DIR/proxy.sock" \
    "${guest_env[@]}" --env "AGENTVM_PORTS=${ports[*]-}" \
    "$IMAGE" bash "$GUEST_SESSION" serve >/dev/null
  # A VM that dies right away, as on a guest error, keeps its log, since
  # stop removes the container rather than --rm.
  sleep 0.5
  vm_running || die "the VM stopped right after its start: $(container logs "$name" 2>&1 | tail -n 5)"
  for port in ${ports[@]+"${ports[@]}"}; do
    detach socat "TCP-LISTEN:$port,bind=127.0.0.1,fork,reuseaddr" "UNIX-CONNECT:$run/ports/$port"
  done
  starting=
}

# The directory that holds the guest script itself. setup/link links one
# file at a time, so guest/ under ~ is a directory of links into the
# dotfiles, whose path in the VM is the repository copy when the dotfiles
# are the repository. The link's target avoids the copy's script.
guest_dir() {
  local script
  script=$(readlink -f "$LIBEXEC/guest/session.sh")
  printf '%s' "${script%/*}"
}

check_image() {
  local error
  error=$(container image inspect "$IMAGE" 2>&1 >/dev/null) ||
    die "no usable image, which agents vm build builds: $error"
}

# The mount option for the host path $1, with :ro for a read-only share.
share() {
  local path=${1%:ro} readonly=
  [ "$path" = "$1" ] || readonly=,readonly
  [ -e "$path" ] || die "$path does not exist"
  printf 'type=bind,source=%s,target=%s%s' "$path" "$path" "$readonly"
}

# Stops the VM and what served it.
stop_vm() {
  if vm_running; then
    container stop "$name" >/dev/null
  fi
  clear_run
}

# Removes the VM's runtime and the stopped container, whose name the
# next start takes.
clear_run() {
  local pid
  for pid in $(cat "$run/proxy.pid" "$run/pids" 2>/dev/null); do
    kill "$pid" 2>/dev/null || :
  done
  rm -rf "$run"
  container rm "$name" >/dev/null 2>&1 || :
}

# Stops every VM, including one an older agentvm left, and frees what
# `container` keeps: the stopped containers, the builder with its layer
# cache, and the images nothing names. The copies stay, since they hold
# kept changes and the caches. The next build runs in full.
prune() {
  local dir id
  for dir in "$STATE"/copies/*/run "$STATE/shell/run"; do
    [ -f "$dir/name" ] || continue
    run=$dir
    name=$(cat "$dir/name")
    stop_vm
  done
  for id in $(container list --all --quiet | grep "^$HOST-" || :); do
    container stop "$id" >/dev/null 2>&1 || :
    container rm "$id" >/dev/null 2>&1 || :
  done
  container builder delete --force >/dev/null 2>&1 || :
  container image prune >/dev/null 2>&1 || :
  container system df
}

# Prints each VM with its state and repository.
list_vms() {
  local running dir name state
  running=$(container list --quiet 2>/dev/null || :)
  for dir in "$STATE"/copies/*/run "$STATE/shell/run"; do
    [ -f "$dir/name" ] || continue
    name=$(cat "$dir/name")
    state=stopped
    ! grep -qx "$name" <<<"$running" || state=running
    printf '%s\t%s\t%s\n' "$name" "$state" "$(cat "$dir/root")"
  done
}

# Runs the guest session in the VM with $1 as its mode and the rest as
# its arguments.
guest() {
  local var opts=()
  [ ! -t 0 ] || opts+=(--tty)
  # container sets TERM=xterm otherwise, and nvim then scrolls a split with
  # left and right margins, which tmux ignores, so the scroll smears the
  # neighboring windows.
  for var in TERM COLORTERM; do
    [ -z "${!var:-}" ] || opts+=(--env "$var=${!var}")
  done
  container exec --interactive "${opts[@]}" ${env[@]+"${env[@]}"} \
    --uid "$(id -u)" --gid "$(id -g)" "${guest_env[@]}" \
    --env "AGENTVM_WORKDIR=$workdir" --env "AGENTVM_SNAPSHOT=${snap:-}" \
    --env "AGENTVM_STATUS_ID=${session##*/}" \
    "$name" bash "$GUEST_SESSION" "$@"
}

# Takes the copy's changes from the guest as $session/vm.bundle, with
# their base commit in $session/base. They come through the guest's
# stdout, the base on the first line, so no file the guest left in a
# shared directory can redirect the read.
fetch_bundle() {
  local handoff="$session/handoff" base=
  guest bundle </dev/null >"$handoff"
  IFS= read -r base <"$handoff" || :
  printf '%s' "$base" >"$session/base"
  tail -n +2 "$handoff" >"$session/vm.bundle"
}

# Starts this VM's nono proxy on the host's loopback, on port $1 or an
# OS-assigned one for 0, with the profiles listed in file $2, and records
# the port in run/port. A later start on the same port keeps the bridge's
# target, so new profiles join without a VM restart.
start_proxy() {
  local log="$run/proxy.log" extends=() profile seen pid port
  for profile in $(cat "$2"); do
    extends+=(--extends "$profile")
  done
  seen=$(listens "$log")
  NONO_PROXY_PASS=$(cat "$run/pass") detach nono proxy -p agentvm ${extends[@]+"${extends[@]}"} \
    --port "$1" --proxy-ca-cert "$CA_CERT" --proxy-ca-key "$CA_KEY"
  pid=$!
  echo "$pid" >"$run/proxy.pid"
  # The keychain may ask for access first.
  until [ "$(listens "$log")" -gt "$seen" ]; do
    kill -0 "$pid" 2>/dev/null || die "the proxy did not start: $(cat "$log")"
    sleep 0.2
  done
  port=$(sed -n 's/.*listening on 127\.0\.0\.1:\([0-9]*\).*/\1/p' "$log" | tail -n 1)
  echo "$port" >"$run/port"
}

# Prints how often the proxy log $1 reports a listening proxy.
listens() {
  local count
  count=$(grep -c 'listening on' "$1" 2>/dev/null || :)
  echo "${count:-0}"
}

# Bridges the Unix socket run/proxy.sock to the proxy's port. The proxy
# listens on TCP, and `container` relays only Unix sockets into the VM,
# with the host socket's mode. The socket sits in the private run
# directory, so the mode lets no other host user in.
start_bridge() {
  local pid
  detach socat "UNIX-LISTEN:$run/proxy.sock,fork,mode=0666" "TCP:127.0.0.1:$(cat "$run/port")"
  pid=$!
  until [ -e "$run/proxy.sock" ]; do
    kill -0 "$pid" 2>/dev/null || die "the proxy bridge did not start"
    sleep 0.05
  done
}

# Restarts the proxy when this session stacks profiles the VM's proxy
# lacks. Profiles only join, so every session keeps what it had. The old
# proxy holds the port until it exits, and run/profiles changes only
# once the new proxy listens, so a failed restart reruns next session.
ensure_profiles() {
  local union old
  [ -f "$run/profiles" ] || return 0
  union=$(printf '%s\n' ${profiles[@]+"${profiles[@]}"} | cat - "$run/profiles" | sort -u)
  [ "$union" != "$(cat "$run/profiles")" ] || return 0
  printf '%s\n' "$union" >"$run/profiles.next"
  old=$(cat "$run/proxy.pid")
  kill "$old" 2>/dev/null || :
  while kill -0 "$old" 2>/dev/null; do
    sleep 0.05
  done
  start_proxy "$(cat "$run/port")" "$run/profiles.next"
  mv "$run/profiles.next" "$run/profiles"
}

# Runs "$@" past this session's life, with its output in run/proxy.log
# and its pid in $! and run/pids. nohup keeps the terminal's hangup from
# it, and disown keeps bash from reporting its end.
detach() {
  nohup "$@" </dev/null >>"$run/proxy.log" 2>&1 &
  echo $! >>"$run/pids"
  disown
}

# Creates the proxy's CA once. The image trusts it, so a new CA needs
# `agentvm build`.
ensure_ca() {
  [ ! -s "$CA_CERT" ] || return 0
  (umask 077 && "$OPENSSL" req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
    -keyout "$CA_KEY" -out "$CA_CERT" -days 3650 -subj "/CN=agentvm proxy" \
    -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign 2>/dev/null)
}

# Passes the guest's status files to $on_status while the session runs.
# Every session in the VM writes the same names, so each gets its own
# folder, named after $session. bash reports the sleep that stop_status
# ends.
start_status() {
  [ -n "$on_status" ] || return 0
  watch_status "$run/exchange/status/${session##*/}" 2>/dev/null &
  status_pid=$!
  disown
}

# A read of a pipe the guest swapped in after the check blocks, so the
# watcher's children go too.
stop_status() {
  [ -n "${status_pid:-}" ] || return 0
  pkill -P "$status_pid" 2>/dev/null || :
  kill "$status_pid" 2>/dev/null || :
  status_pid=
  "$on_status"
}

# Passes the changes in the status folder $1 to $on_status once a
# second, as NAME VALUE, with an empty VALUE for a file that went. The
# last values sit in the private $session.
watch_status() {
  local dir="$1" seen="$session/status" file name value count
  mkdir -p "$seen"
  while sleep 1; do
    count=0
    for file in "$dir"/*; do
      name=${file##*/}
      [[ "$name" =~ $STATUS_NAME ]] || continue
      ((++count <= STATUS_FILES)) || break
      value=$(guest_line "$file") || continue
      [ "$value" != "$(cat "$seen/$name" 2>/dev/null)" ] || continue
      printf '%s' "$value" >"$seen/$name"
      "$on_status" "$name" "$value"
    done
    for file in "$seen"/*; do
      name=${file##*/}
      [ -e "$file" ] && [ ! -f "$dir/$name" ] || continue
      rm "$file"
      "$on_status" "$name" ""
    done
  done
}

# Prints the first line of the guest-written file $1, as printable ASCII
# only, so no escape sequence reaches a terminal. A link or a pipe the
# guest left in its place reads as nothing.
guest_line() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  head -c "$STATUS_BYTES" "$1" | head -n 1 | LC_ALL=C tr -cd '[:print:]\t'
}

# Shows the copy's changes and asks whether to take, drop, or keep them.
# The summary lists new links, mode changes, and binary files, whose
# content the pager can't show. Keeping leaves the changes in the copy
# for a later take.
review() {
  local patch="$session/patch" answer
  if [ ! -s "$session/vm.bundle" ]; then
    echo "agentvm: the VM copy has no changes"
    return
  fi
  fetch_changes

  if [ -t 0 ] && [ -t 1 ]; then
    page "$patch"
  fi
  git apply --stat --summary "$patch"
  git apply --numstat "$patch" | awk -F'\t' '$1 == "-" { print "binary: " $3 }'
  echo "agentvm: the VM's commits are agentvm/vm, in jj vm@agentvm"
  # stdin can come back from the VM or the pager non-blocking, and read
  # then fails with EAGAIN instead of waiting for the answer.
  perl -MFcntl -e 'fcntl(STDIN, F_SETFL, fcntl(STDIN, F_GETFL, 0) & ~O_NONBLOCK)' || :
  read -rp "Take, drop, or keep the VM changes? [t/d/K] " answer || answer=k
  case "$answer" in
  t*)
    if ! git -C "$root" apply "$patch"; then
      cp "$patch" "$STATE/rejected.patch"
      die "the patch does not apply, see $STATE/rejected.patch"
    fi
    guest reset </dev/null
    ;;
  d*) guest reset </dev/null ;;
  esac
}

# Fetches the VM's bundle into the repository as agentvm/vm, jj's
# vm@agentvm, and writes the diff of its changes to $session/patch. Git
# checks every object, and the bundle must build on a commit the
# repository has, which the guest names in $session/base. Host git
# computes the diff, not the guest.
fetch_changes() {
  local base
  base=$(head -c 65 "$session/base" 2>/dev/null) || :
  [[ "$base" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || die "the VM named no base for its changes"
  git -C "$root" cat-file -e "$base^{commit}" 2>/dev/null || die "the VM's changes build on an unknown commit"
  git -C "$root" -c fetch.fsckObjects=true fetch -q --no-tags --no-write-fetch-head \
    "$session/vm.bundle" "+refs/agentvm/vm:refs/remotes/agentvm/vm"
  git -C "$root" diff --binary "$base" refs/remotes/agentvm/vm >"$session/patch"
}

# Pages the patch $1 through delta, the diff pager jj uses, or less
# without it. The guest wrote the patch, so it passes through visible
# first, and no sequence in it reaches the terminal. delta asks the
# terminal for its colors, and less reads the late answer as keystrokes,
# so it scrolls and redraws on its own.
page() {
  if command -v delta >/dev/null; then
    visible <"$1" | delta --paging always --detect-dark-light never
  else
    visible <"$1" | LESS='' less
  fi
}

# Prints stdin with every control character turned into visible text: ^X
# for the C0 characters and DEL, <U+0080> and so on for the C1 ones, which
# terminals read as escape sequences too. Tabs, newlines, and UTF-8 text
# stay.
visible() {
  LC_ALL=C perl -pe 's/([\x00-\x08\x0b-\x1f\x7f])/"^" . chr(ord($1) ^ 64)/ge;
    s/\xc2([\x80-\x9f])/sprintf("<U+%04X>", ord($1))/ge'
}

# Commits the working tree of the repository in $PWD through a temporary
# index, so its index and history stay untouched, and prints the commit.
# A repository without commits gets a root commit. The ref keeps the
# commit from git's pruning, which a kept copy may need weeks later.
snapshot() {
  local tree dir commit parent=()
  dir=$(mktemp -d "$STATE/index.XXXXXX")
  cp "$(git rev-parse --git-path index)" "$dir/index" 2>/dev/null || :
  GIT_INDEX_FILE="$dir/index" git add -A :/
  tree=$(GIT_INDEX_FILE="$dir/index" git write-tree)
  rm -r "$dir"
  if git rev-parse -q --verify HEAD >/dev/null; then
    parent=(-p HEAD)
  fi
  commit=$(git commit-tree --no-gpg-sign ${parent[@]+"${parent[@]}"} -m "agentvm: host working tree" "$tree")
  git update-ref refs/agentvm/snapshot "$commit"
  echo "$commit"
}

# Builds the image. The build runs downloaded install scripts, so its
# context holds the CA's certificate and the dotfiles' working tree,
# without ignored files, and never the CA's key, the repository copies,
# or a host checkout.
#
# The builder keeps its layers, so a build after a dotfiles change redoes
# the last layer only. The cached layer's package versions stand until
# --fresh, which empties the builder first. The recipe's base goes into
# its tar as a tree with a fixed time, so the same files give the same
# bytes and the cache holds.
build() {
  local source=${DOTFILES_DIR:?} context snap rc=0 started=$SECONDS rootfs=0 prepared image pruned outcome phases
  ensure_ca
  if [ ! -s "$DATA/alarm.tar.gz" ]; then
    fetch_rootfs "$DATA/alarm.tar.gz"
    rootfs=$((SECONDS - started))
  fi
  context=$(mktemp -d "$STATE/build.XXXXXX")
  cp -c "$DATA/alarm.tar.gz" "$context/alarm.tar.gz"
  cp "$CA_CERT" "$context/ca.pem"
  cp "$LIBEXEC/image/prepare.sh" "$context/"
  snap=$(cd "$source" && snapshot)
  git -C "$source" archive --mtime=1970-01-01T00:00:00Z -o "$context/base.tar" "$snap^{tree}" -- "${RECIPE_BASE[@]}"
  git -C "$source" archive -o "$context/source.tar" "$snap"
  if [ -n "$fresh" ]; then
    container builder delete --force >/dev/null 2>&1 || :
  fi
  prepared=$((SECONDS - started - rootfs))
  # The redrawn tty view flickers the cursor for the whole build. The
  # builder gets the host's cores, since parser builds and the layer
  # export bind on CPU.
  container build --progress plain ${fresh:+--no-cache} \
    --cpus "$(sysctl -n hw.ncpu)" \
    -f "$LIBEXEC/image/Containerfile" -t "$IMAGE" \
    --build-arg GUEST_USER="$USER" --build-arg GUEST_UID="$(id -u)" \
    --build-arg GUEST_GID="$(id -g)" "$context" || rc=$?
  image=$((SECONDS - started - rootfs - prepared))
  rm -r "$context"
  # A stopped builder holds no CPUs or memory, and its cache stays for the
  # next build.
  container builder stop >/dev/null 2>&1 || echo "agentvm: the builder still runs, see container builder status" >&2
  container image prune >/dev/null 2>&1 || :
  pruned=$((SECONDS - started - rootfs - prepared - image))
  # The phases, since the builder's own times stop at its steps.
  outcome='done'
  [ "$rc" -eq 0 ] || outcome=failed
  phases="context $(clock "$prepared"), image $(clock "$image"), prune $(clock "$pruned")"
  [ "$rootfs" -eq 0 ] || phases="rootfs $(clock "$rootfs"), $phases"
  echo "agentvm: build $outcome in $(clock $((SECONDS - started))): $phases"
  return "$rc"
}

# Prints $1 seconds as minutes and seconds.
clock() {
  printf '%dm%02ds' $(($1 / 60)) $(($1 % 60))
}

# Downloads the Arch Linux ARM rootfs to $1, which only a tarball whose
# signature checks out reaches.
fetch_rootfs() {
  local gnupg
  gnupg=$(mktemp -d "$STATE/gnupg.XXXXXX")
  mkdir -p "${1%/*}"
  curl -fSL -o "$1.tmp" "$ALARM"
  curl -fSL -o "$1.sig" "$ALARM.sig"
  curl -fsSL "$ALARM_KEYRING" | GNUPGHOME=$gnupg gpg --batch --quiet --import
  if ! GNUPGHOME=$gnupg gpg --batch --status-fd 1 --verify "$1.sig" "$1.tmp" 2>/dev/null |
    grep -q "^\[GNUPG:\] VALIDSIG $ALARM_KEY "; then
    rm -r "$gnupg" "$1.tmp" "$1.sig"
    die "the rootfs signature does not verify"
  fi
  rm -r "$gnupg" "$1.sig"
  mv "$1.tmp" "$1"
}

die() {
  echo "agentvm: $*" >&2
  exit 1
}

# Prints the usage and exits with $1.
usage() {
  cat >&2 <<EOF
Usage: agentvm [options] run -- CMD [ARGS...] | shell | pane DIR
       agentvm take | drop | stop | ls | build [--fresh] | prune

Options:
  --extends PROFILE   stack a nono profile on the proxy (repeatable)
  --env KEY=VALUE     set a variable in the session (repeatable)
  --persist PATH      keep this path under the guest's home per repository
  --mount PATH[:ro]   share this host path at the same path (repeatable)
  --publish PORT      serve the guest's PORT on the host's loopback
  --cpus N            the VM's CPUs, config.toml's unless set
  --memory SIZE       the VM's memory, config.toml's unless set
  --on-status CMD     run CMD NAME VALUE on a status change, CMD alone at
                      the session's end
EOF
  exit "$1"
}

# A test sources this script for its functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
