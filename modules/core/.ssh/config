# ── Machine-local host configs ─────────────────────────
# Drop *.conf files into ~/.ssh/conf.d/ for per-host overrides, such as
# ~/.ssh/conf.d/work.conf with Host entries for work servers.
Include conf.d/*.conf

# ── Defaults ────────────────────────────────────────────
Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    StrictHostKeyChecking accept-new
    # Reuse TCP connections.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m
    # Post-quantum hybrid key exchange only, so recorded sessions stay
    # sealed against a future quantum computer. A host without it fails to
    # connect. Give it a classical KexAlgorithms in conf.d, which comes
    # first and wins.
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512
    HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com
    # AEAD ciphers with 256-bit keys, which Grover's algorithm halves to
    # 128 bits. The AEAD ciphers carry their own MAC, so MACs only applies
    # to a host that falls back to aes256-ctr.
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
