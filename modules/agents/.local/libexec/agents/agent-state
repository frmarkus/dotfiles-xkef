#!/usr/bin/env bash
# Owns the agent state the `mux-agents` picker reads. The Claude Code hook,
# the pi extension, and agents publishing a task summary all write through
# this script, so the format lives in one place.
#
#   agent-state set <agent> <state> [tool] [cwd]
#   agent-state task <summary>
#   agent-state clear
#   agent-state list [wezterm|tmux]
#
# Entries sit under $XDG_STATE_HOME/agents, keyed by the pane the agent
# runs in: wezterm-<pane id>, or tmux-<host>-<pane id> in tmux. The key
# gives the picker a join back to its multiplexer, and an entry whose pane
# is gone has nothing to join to. The host keeps tmux panes of different
# servers apart, since every tmux server numbers its panes from 0.
# Outside both, the write commands do nothing.
#
# <pane> holds one tab-separated record: agent, state, tool, epoch, and cwd.
# The cwd goes last so a path never shifts another field. <pane>.task holds
# the summary. It stays a separate file because the agent writes it while
# its hooks write the record, and neither write may drop the other.
#
# `list` prints pane, agent, state, tool, epoch, cwd, and task per entry. An
# empty field reads as "-", so a run of tabs never collapses under `read`.
# Given a multiplexer, it keeps that multiplexer's entries from this host
# and prints the multiplexer's own pane id, 12 in WezTerm or %12 in tmux,
# in place of the key.
set -euo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agents"
readonly MAX_TASK_LENGTH=60
readonly NONE=-
readonly PANE_KEY='^(wezterm-[0-9]+|tmux-[A-Za-z0-9.-]+-[0-9]+)$'

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

# Replaces tabs and line breaks, which would split or end a record.
field() {
  local value=${1//[$'\t\r\n']/ }
  printf '%s' "${value:-$NONE}"
}

# Writes through a temp file so a reader never sees a half-written line. The
# dot prefix keeps the temp file out of `list`.
write() {
  local target=$1 value=$2 tmp
  umask 077
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.${target##*/}.XXXXXX")
  printf '%s\n' "$value" >"$tmp"
  mv -f "$tmp" "$target"
}

list() {
  local mux=${1:-} prefix file pane record task
  case "$mux" in
  wezterm) prefix=wezterm- ;;
  tmux) prefix=$(tmux_key) ;;
  '') prefix='' ;;
  *) usage ;;
  esac

  for file in "$STATE_DIR"/wezterm-* "$STATE_DIR"/tmux-*; do
    pane=${file##*/}
    [[ "$pane" =~ $PANE_KEY ]] || continue
    if [ -n "$prefix" ]; then
      [[ "$pane" == "$prefix"* ]] || continue
      pane=${pane#"$prefix"}
      [ "$mux" = wezterm ] || pane=%$pane
    fi
    IFS= read -r record <"$file" || continue
    task=$NONE
    if [ -f "$file.task" ]; then
      IFS= read -r task <"$file.task" || task=$NONE
    fi
    printf '%s\t%s\t%s\n' "$pane" "$record" "$(field "$task")"
  done
}

# The key prefix of this host's tmux panes.
tmux_key() {
  printf 'tmux-%s-' "${HOSTNAME%%.*}"
}

cmd=${1:-}
case "$cmd" in
set | task | clear) shift ;;
list)
  list "${2:-}"
  exit 0
  ;;
*) usage ;;
esac

# tmux is checked first: it can run inside WezTerm, but not the reverse.
if [ -n "${TMUX_PANE:-}" ]; then
  pane=$(tmux_key)${TMUX_PANE#%}
else
  pane=wezterm-${WEZTERM_PANE:-}
fi
[[ "$pane" =~ $PANE_KEY ]] || exit 0
entry="$STATE_DIR/$pane"

case "$cmd" in
set)
  [ $# -ge 2 ] || usage
  case "$2" in
  idle | busy | waiting) ;;
  *)
    echo "agent-state: unknown state '$2'" >&2
    exit 2
    ;;
  esac
  printf -v record '%s\t%s\t%s\t%s\t%s' \
    "$(field "$1")" "$2" "$(field "${3:-}")" "$(date +%s)" "$(field "${4:-$PWD}")"
  write "$entry" "$record"
  ;;
task)
  summary=$(field "$*")
  [ "$summary" != "$NONE" ] || exit 0
  write "$entry.task" "${summary:0:MAX_TASK_LENGTH}"
  ;;
clear)
  rm -f "$entry" "$entry.task"
  ;;
esac
