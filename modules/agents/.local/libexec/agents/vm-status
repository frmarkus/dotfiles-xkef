#!/usr/bin/env bash
# Maps the agent VM's status into the picker's entry for this pane.
# agentvm runs it as `--on-status` with NAME VALUE when the guest changes a
# status file, VALUE in printable text only, and alone when the VM stops.
#
# In the guest, agent-state keeps its entries in the status folder under
# the fixed key that agentvm/guest.d/agents.sh sets, so the record and the
# task arrive as KEY and KEY.task. Everything else the guest writes there
# goes unused.
set -euo pipefail

readonly KEY=wezterm-0
agent_state="${0%/*}/agent-state"

[ $# -gt 0 ] || exec "$agent_state" clear

case $1 in
"$KEY")
  IFS=$'\t' read -r agent state tool _ cwd <<<"${2:-}"
  if [[ "$agent" =~ ^[a-z]{1,20}$ ]] && [[ "$state" =~ ^(idle|busy|waiting)$ ]]; then
    exec "$agent_state" set "$agent" "$state" "${tool:0:40}" "${cwd:0:200}"
  fi
  exec "$agent_state" clear
  ;;
"$KEY.task")
  [ -z "${2:-}" ] || exec "$agent_state" task "$2"
  ;;
esac
