#!/usr/bin/env bash
# Reports the tool calls that failed in Claude Code sessions, read in place
# from ~/.claude/projects on this machine.
#
#   agent-trace [--all] [--since <date>] list
#   agent-trace [--all] [--since <date>] errors [session-id]
#   agent-trace [--all] [--since <date>] denials [session-id]
#   agent-trace [--all] [--since <date>] prompts [session-id]
#   agent-trace [--all] [--since <date>] corrections [session-id]
#
# The scope is the sessions that ran inside the current repository, or
# every session with --all. A session id picks that one session wherever
# it ran. --since drops what happened before an ISO 8601 date, such as
# 2026-09-26, so a restructured repository reports on its current layout.
# Every row names its environment: this machine's host name.
#
# `list` prints id, environment, start, permission mode, error count,
# denial count, and title per session. `errors` prints session,
# environment, timestamp, tool, input, and the first telling output line
# per failed tool call. `denials` keeps the failures whose
# output reads like a permission denial. A subagent failure carries the
# session label <id>/agent-<name>.
#
# `prompts` prints session, environment, timestamp, the tail of the
# agent's last reply, and the message per prompt the user typed. The reply
# shows what a correction answers. `corrections` keeps the prompts whose
# wording reads like a correction, such as "no", "don't", or "again".
set -euo pipefail

readonly CLAUDE_PROJECTS="$HOME/.claude/projects"
readonly OS_DENIAL_PATTERN='operation not permitted|permission denied|read-only file system|\beperm\b|\beacces\b|sandbox[ _-]?(apply|blocked|denied)'
# Claude Code's own refusals: permission rules, the auto mode classifier,
# user rejections, and PreToolUse hooks.
readonly CLAUDE_DENIAL_PATTERN='has been denied|denied by the claude code|doesn.t want to proceed|pretooluse:[a-z]+ hook error'
readonly DENIAL_PATTERN="$OS_DENIAL_PATTERN|$CLAUDE_DENIAL_PATTERN"
readonly MAX_FIELD_LENGTH=200
readonly MAX_PROMPT_LENGTH=800
readonly CORRECTION_PATTERN='(^|[^a-z])(no[,. ]|don.?t|never|stop|wrong|instead|why did|i said|again|revert|undo|not what|should|always)'

# Emits one JSON object per failed tool call in a transcript. It pairs each
# error result with the tool call that caused it, and picks the first line
# that says more than "Exit code N", preferring one that matches $denial.
readonly FAILURES_JQ='
  [inputs] as $lines
  | ($lines
    | map(.message.content[]? | select(.type == "tool_use") | {key: .id, value: .})
    | from_entries) as $uses
  | $lines[]
  | .timestamp as $ts
  | .message.content[]?
  | select(.type == "tool_result" and .is_error == true)
  | (.content | if type == "array" then map(.text // "") | join("\n") else tostring end) as $text
  | ($text | split("\n") | map(select(test("\\S") and (test("^Exit code [0-9]+$") | not)))) as $telling
  | ($telling | map(select(test($denial; "i")))) as $denied
  | $uses[.tool_use_id] as $use
  | {
      session: $session,
      env: $env,
      ts: $ts,
      tool: $use.name,
      input: ($use.input.command // $use.input.file_path // $use.input.path // $use.input),
      denial: ($denied | length > 0),
      line: (($denied + $telling)[0] // "")
    }
  | select($since == "" or .ts >= $since)
'

# Emits one JSON object per prompt the user typed, with the text of the
# agent reply before it. Claude Code also records slash command wrappers,
# reminders, notifications, and interrupts as user lines, so those drop.
readonly PROMPTS_JQ='
  def text: if type == "string" then . else map(select(.type == "text") | .text) | join("\n") end;
  foreach (inputs | select(.isSidechain != true)) as $l ({reply: ""};
    .prompt = null
    | if $l.type == "assistant" then
        ($l.message.content | text) as $t
        | if ($t | test("\\S")) then .reply = $t else . end
      elif $l.type == "user" and ($l.isMeta | not) then
        ($l.message.content | text) as $t
        | if ($t | test("\\S")) and ($t | test($machine) | not) then
            .prompt = {ts: $l.timestamp, reply: .reply, text: $t}
          else . end
      else . end;
    .prompt // empty)
  | select($since == "" or .ts >= $since)
  | {session: $session, env: $env} + .
'
readonly MACHINE_PROMPT='^\s*(<command-|<local-command|<system-reminder>|<task-notification>|Caveat:|\[Request interrupted)'

scope=repo
since=""

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

die() {
  echo "agent-trace: $*" >&2
  exit 1
}

repo_root() {
  jj --ignore-working-copy root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null
}

# Prints "<environment>\t<projects directory>" per transcript source.
sources() {
  printf '%s\t%s\n' "$(uname -n)" "$CLAUDE_PROJECTS"
}

# Prints "<environment>\t<transcript>" per session in scope. Claude names
# each project directory after the session's cwd with every character
# outside [A-Za-z0-9] turned into "-". A prefix match finds the sessions started in
# subdirectories too, and the recorded cwd drops the unrelated directories
# that share the prefix.
transcripts() {
  local id=${1:-} root="" prefix="" env dir transcript cwd

  if [ -z "$id" ] && [ "$scope" = repo ]; then
    root=$(repo_root) || die "not inside a repository, use --all"
    prefix=${root//[^[:alnum:]]/-}
  fi

  sources | while IFS=$'\t' read -r env dir; do
    for transcript in "$dir/$prefix"*/${id:-*}.jsonl; do
      [ -f "$transcript" ] || continue
      if [ -n "$since" ] && [[ "$(date -r "$transcript" +%F)" < "${since:0:10}" ]]; then
        continue
      fi
      if [ -n "$root" ]; then
        cwd=$(jq -rn 'first(inputs | .cwd // empty)' "$transcript")
        if [ "$cwd" != "$root" ] && [[ "$cwd" != "$root"/* ]]; then
          continue
        fi
      fi
      printf '%s\t%s\n' "$env" "$transcript"
    done
  done
}

# Scans each main transcript and the subagent transcripts beside it.
failures() {
  local env transcript id file label

  transcripts "${1:-}" | while IFS=$'\t' read -r env transcript; do
    id=$(basename "$transcript" .jsonl)
    for file in "$transcript" "${transcript%.jsonl}"/subagents/*.jsonl; do
      [ -f "$file" ] || continue
      label=$id
      if [ "$file" != "$transcript" ]; then
        label=$id/$(basename "$file" .jsonl)
      fi
      jq -cn --arg session "$label" --arg env "$env" --arg since "$since" \
        --arg denial "$DENIAL_PATTERN" "$FAILURES_JQ" "$file"
    done
  done
}

print_failures() {
  jq -r --arg filter "$1" --argjson max "$MAX_FIELD_LENGTH" '
    def clip: tostring | gsub("[\t\r\n]+"; " ") | .[0:$max];
    select($filter == "all" or .denial)
    | [.session, .env, .ts, .tool, (.input | clip), (.line | clip)]
    | @tsv
  '
}

prompts() {
  local env transcript

  transcripts "${1:-}" | while IFS=$'\t' read -r env transcript; do
    jq -cn --arg session "$(basename "$transcript" .jsonl)" --arg env "$env" \
      --arg since "$since" --arg machine "$MACHINE_PROMPT" "$PROMPTS_JQ" "$transcript"
  done | jq -r --argjson max "$MAX_PROMPT_LENGTH" --argjson tail "$MAX_FIELD_LENGTH" '
    def flat: gsub("[\t\r\n]+"; " ");
    [.session, .env, .ts, (.reply | flat | .[-$tail:]), (.text | flat | .[0:$max])]
    | @tsv
  '
}

list() {
  local env transcript id counts

  transcripts | while IFS=$'\t' read -r env transcript; do
    id=$(basename "$transcript" .jsonl)
    counts=$(failures "$id" | jq -rs '[length, map(select(.denial)) | length] | @tsv')
    jq -rn --arg id "$id" --arg env "$env" --arg counts "$counts" --arg since "$since" '
      reduce inputs as $l ({};
        .start //= $l.timestamp
        | .end = ($l.timestamp // .end)
        | .mode = ($l.permissionMode // .mode)
        | .title = ($l.aiTitle // .title))
      | select($since == "" or .end >= $since)
      | [$id, $env, .start // "-", .mode // "-", $counts, .title // "-"]
      | join("\t")
    ' "$transcript"
  done | sort -t $'\t' -k3
}

while [ $# -gt 0 ]; do
  case "$1" in
  --all) scope=all ;;
  --since) since=${2:?--since needs a date} && shift ;;
  *) break ;;
  esac
  shift
done

case "${1:-}" in
list) list ;;
errors) failures "${2:-}" | print_failures all ;;
denials) failures "${2:-}" | print_failures denials ;;
prompts) prompts "${2:-}" ;;
corrections) prompts "${2:-}" | awk -F '\t' -v re="$CORRECTION_PATTERN" 'tolower($5) ~ re' ;;
*) usage ;;
esac
