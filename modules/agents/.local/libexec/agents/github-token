#!/bin/sh
# Prints the GitHub token that nono's credential proxy injects, or with
# `git`, the same token as the user:password pair of a Git basic auth.
#
#   github-token [git]
#
# nono runs this on the host for the github profile. The token sits in the
# keychain on macOS, or the Secret Service on Linux, under the account
# github-<user>.
#
# The user comes from the global Git config only. The agent can write a
# repository's .git/config, and a github.user there would pick another
# account's token.
set -eu

# nono sanitizes PATH for its credential brokers, which drops Homebrew's gh.
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

user=$(git config --global --includes --get github.user || gh config get -h github.com user)
account="github-$user"
if command -v security >/dev/null; then
  token=$(security find-generic-password -s nono -a "$account" -w)
else
  token=$(secret-tool lookup service nono account "$account")
fi

case "${1:-}" in
git) printf 'x-access-token:%s' "$token" ;;
'') printf '%s\n' "$token" ;;
*)
  sed -n 's/^#   //p' "$0" >&2
  exit 2
  ;;
esac
