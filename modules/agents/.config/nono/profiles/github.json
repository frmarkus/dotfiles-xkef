{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "credential_capture": {
    "github": {
      "command": [
        "/bin/sh",
        "-c",
        "exec \"$HOME/.local/libexec/agents/github-token\""
      ],
      "cache_ttl_secs": 900,
      "timeout_secs": 60
    },
    "github_git": {
      "command": [
        "/bin/sh",
        "-c",
        "exec \"$HOME/.local/libexec/agents/github-token\" git"
      ],
      "cache_ttl_secs": 900,
      "timeout_secs": 60
    }
  },
  "meta": {
    "description": "GitHub's API and Git over HTTPS through the credential proxy, which the agents profile and the agent VM's --github stack on",
    "name": "github",
    "version": "1.0.0"
  },
  "network": {
    "credentials": ["github", "github_git"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}"
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "cmd://github_git",
        "env_var": "GITHUB_GIT_TOKEN",
        "inject_mode": "basic_auth"
      }
    }
  }
}
