{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "description": "Claude credentials for the agent VM's proxy, which agents vm stacks on agentvm",
    "name": "agentvm-claude",
    "version": "1.0.0"
  },
  "network": {
    "credentials": [
      "claude"
    ],
    "custom_credentials": {
      "claude": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "claude_code_oauth_token",
        "env_var": "CLAUDE_CODE_OAUTH_TOKEN",
        "credential_format": "Bearer {}"
      }
    }
  }
}
