{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": false,
  "autoMode": {
    "classifyAllShell": true
  },
  "cleanupPeriodDays": 99999,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-bash-guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "concise",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Skill",
      "Bash(jj log *)",
      "Bash(jj diff *)",
      "Bash(jj st *)",
      "Bash(jj status *)",
      "Bash(jj show *)",
      "Bash(jj file list *)",
      "Bash(jj file show *)",
      "Bash(jj op log *)",
      "Bash(jj evolog *)",
      "Bash(jj bookmark list *)",
      "Bash(jj workspace list *)",
      "Bash(jj root *)",
      "Bash(jj help *)",
      "Bash(jj config get *)",
      "Bash(jj config list *)",
      "WebSearch",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*rm -r -f*)",
      "Bash(*rm -f -r*)",
      "Bash(*git push*)",
      "Bash(*jj git push*)",
      "Bash(*git merge *)",
      "Bash(*git rebase*)",
      "Bash(*git reset --hard*)",
      "Bash(*git checkout -- *)",
      "Bash(*git clean*)",
      "Bash(*git stash drop*)",
      "Bash(*jj abandon*)",
      "Bash(*jj restore*)",
      "Bash(*> .env*)",
      "Bash(*> .env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.production)",
      "Edit(//**/.env.staging)",
      "Edit(//**/id_rsa)",
      "Edit(//**/id_ed25519)",
      "Edit(//**/id_ecdsa)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/credentials.json)",
      "Edit(//**/.netrc)",
      "Edit(~/.aws/credentials)"
    ]
  },
  "plansDirectory": ".claude-notes",
  "preferredNotifChannel": "iterm2",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Processing"]
  },
  "statusLine": {
    "command": "~/.claude/hooks/claude-statusline",
    "type": "command"
  },
  "tui": "fullscreen"
}
